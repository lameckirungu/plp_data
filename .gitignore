# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/

# Virtual environments
.env
.venv
env/
venv/
ENV/

# Jupyter Notebook
.ipynb_checkpoints/
*/.ipynb_checkpoints/
profile_default/
ipython_config.py

# Anaconda
.conda/

# VS Code
.vscode/
*.code-workspace

# OS
.DS_Store
Thumbs.db
desktop.ini

# Data files (add exceptions below if you want to track sample data)
*.csv
*.xlsx
*.xls
*.json
*.parquet
*.db
*.sqlite

# Keep assets folder tracked even with data rules above
!assets/.gitkeep
!assets/README.md
!/week3/*.csv
!/week3/*.db

# Week 10 PumpGuard Ops: committed synthetic training and demo telemetry.
!/week10/week10_ops_tool/data/*.csv

# Hackathon: track committed synthetic source data and pipeline evidence
!/hackathon/data/raw/*.csv
!/hackathon/data/processed/*.csv
!/hackathon/reports/*.json

# Hackathon: track frontend config (package.json, package-lock.json,
# tsconfig*.json) -- without these the web/ app can't even be installed.
# node_modules/ and dist/ stay ignored via web/.gitignore and the `dist/`
# rule above, so this can't accidentally pull build output back in.
!/hackathon/web/**/*.json

# Logs and temp
*.log
*.tmp
*.bak
